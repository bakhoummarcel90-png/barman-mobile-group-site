# Copiez ce fichier en .env.local puis adaptez les valeurs.

# Emplacement du fichier SQLite et des photos (par défaut : ./data)
# DATA_DIR=./data

# Mot de passe des comptes de démonstration créés par `npm run seed`.
# Choisissez le vôtre ; s'il est absent, le script en génère un aléatoire
# et l'affiche dans le terminal.
# DEMO_PASSWORD=

# Code exigé sur la page /installation (première mise en ligne). Choisissez-le.
# SETUP_CODE=

# Pages légales exigées par les stores (/confidentialite, /suppression-compte)
# LEGAL_EDITOR_NAME=
# LEGAL_EDITOR_ADDRESS=
# LEGAL_CONTACT_EMAIL=

# Application Android (Play Store) : lien entre l'application et ce site
# ANDROID_PACKAGE_NAME=
# ANDROID_SHA256_FINGERPRINTS=

# Code de vérification d'inscription par e-mail (Brevo, API web)
# BREVO_API_KEY=
# MAIL_FROM_EMAIL=
# MAIL_FROM_NAME=SenLivraison

# --- Intégrations NON activées dans cette version ---
# Wave et Orange Money : la saisie des paiements est manuelle.
# Une future intégration demandera des identifiants marchands officiels
# (clé API Wave Business, identifiants Orange Money Webpay / API marchand),
# obtenus après signature d'un contrat avec chaque opérateur.
# Aucune de ces variables n'est lue par l'application aujourd'hui.
