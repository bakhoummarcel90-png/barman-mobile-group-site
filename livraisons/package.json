{
  "name": "senlivraison",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS de gestion des livraisons pour les commerces en ligne et entreprises de livraison au Sénégal",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --conditions=react-server scripts/seed.ts",
    "test": "tsx --conditions=react-server --test tests/*.test.mts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.544.0",
    "next": "16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
